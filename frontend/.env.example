# Copy this file to .env for local development when you need a custom API URL.
# The build falls back to http://127.0.0.1:8000/api when this is unset.
#
# Local development (default):
VITE_API_URL=http://127.0.0.1:8000/api
#
# Production (set inside Vercel's dashboard, do NOT commit the real value):
# VITE_API_URL=https://YOUR-RENDER-SERVICE.onrender.com/api
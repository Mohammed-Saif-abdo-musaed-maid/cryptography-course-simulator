# ---- Backend (FastAPI) ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
APP_NAME=Cryptography & Information Security Simulator
APP_VERSION=1.0.0
# Logging: debug | info | warning | error
LOG_LEVEL=info
# Security: comma-separated allowed origins for CORS
# (the dev frontend origin is added automatically)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- Frontend (Vite) ----
# Base URL of the backend `/api` endpoints (used by src/services/api.ts)
VITE_API_URL=http://127.0.0.1:8000/api
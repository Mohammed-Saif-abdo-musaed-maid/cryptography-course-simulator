# ---- Backend (FastAPI) ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
APP_NAME=Cryptography & Information Security Simulator
APP_VERSION=1.0.0
# Logging: debug | info | warning | error
LOG_LEVEL=info

# Security: comma-separated allowed browser origins for CORS.
# Local dev origins (http://127.0.0.1:5173, http://localhost:5173, ...) are
# ALWAYS allowed automatically by the backend, so local development works with
# no configuration. List production origins here, one per line concept; keep
# them comma-separated in a single value. Example:
# CORS_ORIGINS=https://mohammed-saif-cryptography-course-simulator.vercel.app
CORS_ORIGINS=

# ---- Frontend (Vite) ----
# Base URL of the backend `/api` endpoints (used by src/services/api.ts).
# Local development default is the local backend. On Vercel this variable is
# set to the deployed backend URL, e.g. https://YOUR-RENDER-SERVICE.onrender.com/api
VITE_API_URL=http://127.0.0.1:8000/api